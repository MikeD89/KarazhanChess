<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
    <!-- Namespace & addon object (must load first) -->
    <Script file="KarazhanChess/Init.lua"/>

    <!-- Utilites -->
    <!-- Order matters: each file imports from the namespace what earlier files exported -->
    <Script file="KarazhanChess/Utils.lua"/>
    <Script file="KarazhanChess/Rules.lua"/>
    <Script file="KarazhanChess/Engine.lua"/>
    <Script file="KarazhanChess/PuzzleCodec.lua"/>
    <Script file="KarazhanChess/FrameUtils.lua"/>
    <Script file="KarazhanChess/Icons.lua"/>
    <Script file="KarazhanChess/Square.lua"/>
    <Script file="KarazhanChess/Piece.lua"/>
    <Script file="KarazhanChess/Game.lua"/>

    <!-- Main -->
    <Script file="KarazhanChess/Main.lua"/>
    <Script file="KarazhanChess/Frame.lua"/>
    <Script file="KarazhanChess/Promotion.lua"/>
    <Script file="KarazhanChess/Computer.lua"/>
    <Script file="KarazhanChess/Puzzles.lua"/>
    <Script file="KarazhanChess/Options.lua"/>

    <!-- Dev builds only: manual test panel (the packager strips this block) -->
    <!--@do-not-package@-->
    <Script file="KarazhanChess/Dev/Tests.lua"/>
    <Script file="KarazhanChess/Dev/TestPanel.lua"/>
    <!--@end-do-not-package@-->
</Ui>
